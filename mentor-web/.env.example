# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL + API keys (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_SECRET_KEY=your_secret_key_here

# Client-side realtime (used by messaging pages / chatbot)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here

# ── AI Chatbot (NVIDIA NIM) ────────────────────────────────────────────────
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Cross-portal links ─────────────────────────────────────────────────────
# Absolute URLs of the sibling portals, used by navbar/footer portal switchers.
# Local dev defaults shown; change for production deployments.
NEXT_PUBLIC_STUDENT_URL=http://localhost:3000
NEXT_PUBLIC_MENTOR_URL=http://localhost:3003
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
